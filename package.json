{
  "name": "ticketbot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "migrate": "npm run migrate --workspace @ticketbot/db",
    "dev": "concurrently -n bot,dash -c blue,magenta \"npm:dev:bot\" \"npm:dev:dash\"",
    "dev:bot": "npm run dev --workspace @ticketbot/bot",
    "dev:dash": "npm run dev --workspace @ticketbot/dashboard",
    "deploy-commands": "npm run deploy-commands --workspace @ticketbot/bot",
    "build": "npm run build --workspaces --if-present",
    "start:bot": "npm run start --workspace @ticketbot/bot",
    "start:dash": "npm run start --workspace @ticketbot/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true
  }
}
