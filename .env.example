# ---------------------------------------------------------------------------
# Shared (bot + dashboard)
# ---------------------------------------------------------------------------
# Relative paths are resolved against the REPO ROOT (not each app's folder), so
# the bot and dashboard always share the same files. Use an absolute path to
# put the data elsewhere.
#
# SQLite database file — both processes open this exact file.
DATABASE_PATH=./data/ticketbot.db
# Directory for generated transcripts (DATA_DIR/transcripts) and dashboard
# image uploads (DATA_DIR/uploads/<guildId>).
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Bot (apps/bot)
# ---------------------------------------------------------------------------
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional: register slash commands to a single guild for instant availability
# during development. Leave blank to register globally (can take up to 1h).
DEV_GUILD_ID=
# Internal HTTP server the dashboard pokes to process jobs immediately.
# Keep it on a private network — the shared secret travels in a plain header.
INTERNAL_PORT=8787
# REQUIRED shared secret. Generate: openssl rand -base64 32
INTERNAL_WAKE_SECRET=
# Optional: Discord webhook URL that receives batched error-level log lines.
# Create one in a private #bot-logs channel (Channel → Integrations → Webhooks).
# Leave blank to disable.
LOG_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Dashboard (apps/dashboard)
# ---------------------------------------------------------------------------
# Same Discord application as the bot.
DISCORD_CLIENT_ID=your-application-id
DISCORD_CLIENT_SECRET=your-oauth-client-secret
# Bot token again, used server-side for REST reads (guild roles/channels).
DISCORD_BOT_TOKEN=your-bot-token
# Auth.js JWT signing secret — REQUIRED. Generate: openssl rand -base64 32
AUTH_SECRET=
# Public origin of the dashboard. Set this explicitly in production (the app
# otherwise trusts the Host header to build OAuth callback URLs).
NEXTAUTH_URL=http://localhost:3000
# How the dashboard reaches the bot's internal HTTP server (private network).
BOT_INTERNAL_URL=http://localhost:8787

# ---------------------------------------------------------------------------
# Offsite backups (docker-compose `backup` service) — all optional
# ---------------------------------------------------------------------------
# Leave blank to keep 14 local nightly archives in the `ticketbot-backups`
# volume only. Fill in to also push each archive to S3-compatible storage
# (Cloudflare R2, DigitalOcean Spaces, AWS S3).
BACKUP_S3_BUCKET=
# e.g. https://<accountid>.r2.cloudflarestorage.com  (omit for AWS S3)
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ---------------------------------------------------------------------------
# Deploy (docker-compose)
# ---------------------------------------------------------------------------
# Which CI-built image tag to run. Defaults to "latest"; set a git sha to pin.
IMAGE_TAG=latest
